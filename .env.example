# Discord OAuth2 Configuration
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_REDIRECT_URI=http://localhost/oauth/callback

# Database Configuration
MYSQL_ROOT_PASSWORD=your_mysql_root_password_here
DB_HOST=mysql
DB_PORT=3306
DB_NAME=hacksim
DB_USER=hacksim_user
DB_PASSWORD=hacksim_password

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_at_least_32_characters
JWT_EXPIRES_IN=86400

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Challenge Engine Configuration
SANDBOX_MODE=safe
MAX_EXECUTION_TIME=30
MAX_MEMORY_MB=512
MAX_CPU_CORES=1

# Application Configuration
APP_ENV=development
DEBUG=true
LOG_LEVEL=debug