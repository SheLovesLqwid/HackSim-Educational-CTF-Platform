{
    "name": "hacksim/backend",
    "description": "HackSim CTF Platform Backend API",
    "type": "project",
    "require": {
        "php": "^8.2",
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.0",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/database": "^10.45",
        "illuminate/pagination": "^10.45",
        "firebase/php-jwt": "^6.10",
        "vlucas/phpdotenv": "^5.6",
        "monolog/monolog": "^3.5",
        "respect/validation": "^2.3",
        "ramsey/uuid": "^4.7",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.8",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "HackSim\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HackSim\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": "php -S localhost:8000 -t public public/index.php",
        "test": "phpunit",
        "check": "phpcs --standard=PSR12 app/",
        "analyze": "phpstan analyse app/"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}